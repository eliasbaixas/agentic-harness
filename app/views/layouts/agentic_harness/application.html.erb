<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for?(:title) ? yield(:title) : "Agentic Harness" %></title>
  <%= csrf_meta_tags %>
  <%# The engine's views are written in Tailwind utility classes. The host app
      need not ship Tailwind — load it here (Play CDN) so the engine is
      self-contained and styled regardless of the host's CSS framework. This
      layout has no host chrome, so Tailwind's preflight reset is harmless. %>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { theme: { extend: { colors: { accent: '#EB466C' } } } };
  </script>
  <%= yield :head %>
</head>
<body class="bg-gray-100 text-gray-900 min-h-screen antialiased">
  <header class="bg-white border-b border-gray-200 sticky top-0 z-30">
    <div class="max-w-[1600px] mx-auto px-4 h-12 flex items-center gap-3">
      <span class="font-bold text-sm text-gray-800 flex items-center gap-1.5">
        <span class="inline-block w-2 h-2 rounded-full" style="background:#EB466C"></span>
        Agent
      </span>
      <nav class="flex items-center gap-1 text-sm text-gray-600">
        <a href="<%= kanban_path %>" class="px-2.5 py-1 rounded-md hover:bg-gray-100 hover:text-gray-900 transition-colors">Kanban</a>
        <a href="<%= docs_path %>" class="px-2.5 py-1 rounded-md hover:bg-gray-100 hover:text-gray-900 transition-colors">Docs</a>
        <a href="<%= admin_night_shifts_path %>" class="px-2.5 py-1 rounded-md hover:bg-gray-100 hover:text-gray-900 transition-colors">Night Shifts</a>
      </nav>
      <a href="/" class="ml-auto text-sm text-gray-400 hover:text-gray-700 transition-colors">&larr; Back to site</a>
    </div>
  </header>

  <% if flash[:alert] %>
    <div class="max-w-[1600px] mx-auto px-4 mt-3">
      <div class="rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-3 py-2"><%= flash[:alert] %></div>
    </div>
  <% end %>
  <% if flash[:notice] %>
    <div class="max-w-[1600px] mx-auto px-4 mt-3">
      <div class="rounded-lg bg-green-50 border border-green-200 text-green-700 text-sm px-3 py-2"><%= flash[:notice] %></div>
    </div>
  <% end %>

  <main>
    <%= yield %>
  </main>
</body>
</html>
